    "CREDITS.md",
    "THIRD-PARTY-NOTICES.txt",
    "credits.json",
    "CHANGELOG.md",
    "ui/credits.tscn",
    "ui/credits.gd",
    "main.tscn",
    "ui",
    "art/boss.png",
    "art/enemy_shot.png",
    "scripts/waves.gd",
    "scripts/save_store.gd",
    "scripts/launch_options.gd",
    "game/bot.gd",
    "game/pause_menu.gd",
    "data",
    "data.json",
    "i18n",
    "sounds",
    "plan",
    "docs",
