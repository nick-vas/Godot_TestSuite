  "tasks": [
    {
      "template": "fix-bug",
      "vars": {
        "report": "the combo multiplier comes one hit late: the fifth enemy destroyed in a row still scores single points"
      },
      "edits": [
        {
          "file": "scripts/Score.cs",
          "find": "Combo / 5",
          "replace": "Combo / 6"
        }
      ],
      "unchanged": [
        "test/ScoreTest.cs"
      ],
      "hidden": [
        "hidden/HiddenMultiplierTest.cs"
      ],
      "reference": "solutions/prototype/fix-bug",
      "decoy": "solutions/prototype/fix-bug-decoy"
    },
    {
      "template": "write-tests",
      "vars": {
        "subject": "Rules class (scripts/Rules.cs: lives, invulnerability and collisions)",
        "file": "test/RulesCollisionsTest.cs",
        "rules": "a hit costs one life, a second hit within two seconds costs nothing, the game is over at zero lives and not before, a destroyed enemy scores its own points, and an enemy with hit points left scores nothing",
        "code": "scripts/Rules.cs"
      },
      "unchanged": [
        "scripts/Rules.cs"
      ],
      "mutantTests": [
        "test/RulesCollisionsTest.cs"
      ],
      "mutants": [
        {
          "name": "a hit costs no life",
          "file": "scripts/Rules.cs",
          "find": "Lives -= 1;",
          "replace": "Lives -= 0;"
        },
        {
          "name": "invulnerability is ignored",
          "file": "scripts/Rules.cs",
          "find": "if (Invulnerable > 0 || IsGameOver)",
          "replace": "if (IsGameOver)"
        },
        {
          "name": "the game is over at one life",
          "file": "scripts/Rules.cs",
          "find": "public bool IsGameOver => Lives <= 0;",
          "replace": "public bool IsGameOver => Lives <= 1;"
        },
        {
          "name": "an enemy's points are ignored",
          "file": "scripts/Rules.cs",
          "find": "return enemy.Points;",
          "replace": "return 100;"
        },
        {
          "name": "hit points are off by one",
          "file": "scripts/Rules.cs",
          "find": "if (enemy.Hp > 0)",
          "replace": "if (enemy.Hp > 1)"
        }
      ],
      "reference": "solutions/prototype/write-tests",
      "decoy": "solutions/prototype/write-tests-decoy"
    },
    {
      "template": "add-feature",
      "vars": {
        "feature": "a best score: Score (scripts/Score.cs) gets an int property Best, the highest Points of any game so far, and Reset() starts a new game (Points and Combo back to 0) but keeps Best"
      },
      "hidden": [
        "hidden/HiddenBestTest.cs"
      ],
      "reference": "solutions/prototype/add-feature",
      "decoy": "solutions/prototype/add-feature-decoy"
    },
    {
      "template": "explain-failure",
      "edits": [
        {
          "file": "test/RulesTest.cs",
          "find": "var rules = new Rules(3);",
          "replace": "var rules = new Rules(4);"
        }
      ],
      "unchanged": [
        "scripts/Rules.cs",
        "scripts/Score.cs",
        "game/Game.cs",
        "test/RulesTest.cs",
        "test/ScoreTest.cs"
      ],
      "expected": {
        "mustInclude": [
          "One_hit_costs_one_life",
          "re:RulesTest\\.cs\\D{0,40}\\b21\\b",
          "re:(?<![\\d.])2(?!\\d)",
          "re:(?<![\\d.])3(?!\\d)"
        ]
      },
      "reference": "solutions/prototype/explain-failure",
      "decoy": "solutions/prototype/explain-failure-decoy"
    }
  ]
}
