          "replace": "keeper.kindling = mini(1, MAX_KINDLING)"
        },
        {
          "name": "a wisp can be played into a full row",
          "file": "scripts/duel.gd",
          "find": "return keeper.free_lane() >= 0",
          "replace": "return true"
