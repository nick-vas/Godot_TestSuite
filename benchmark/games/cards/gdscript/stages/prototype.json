      "vars": {
        "subject": "Duel class (scripts/duel.gd: kindling, playing cards, the lanes, the Clash, the discard pile and the hand limit)",
        "file": "test/unit/test_duel_rules.gd",
        "rules": "a card costs kindling and one that costs more than is left cannot be played, a keeper's kindling each turn is its own turn number up to 6, a wisp goes to the first free lane of its row and none can be played into a full row, the wisps across a lane strike each other with their power, a wisp whose guard reaches 0 falls to its owner's discard pile, a wisp with an empty lane across strikes the other keeper's light, and a card drawn into a hand of 7 goes to the discard pile",
        "code": "scripts/duel.gd"
      },
      "unchanged": [
        "scripts/duel.gd"
      ],
