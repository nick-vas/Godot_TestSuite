  "tasks": [
    {
      "template": "fix-bug",
      "vars": {
        "report": "after undoing a move that collected a spark, the spark stays collected, so the exit opens without it"
      },
      "edits": [
        {
          "file": "scripts/Board.cs",
          "find": "new Step(Position, new List<Vector2I>(Sparks), Moves)",
          "replace": "new Step(Position, Sparks, Moves)"
        }
      ],
      "unchanged": [
        "test/BoardTest.cs"
      ],
      "hidden": [
        "hidden/HiddenUndoTest.cs"
      ],
      "reference": "solutions/prototype/fix-bug",
      "decoy": "solutions/prototype/fix-bug-decoy"
    },
    {
      "template": "write-tests",
      "vars": {
        "subject": "Board class (scripts/Board.cs: the slide, sparks, the exit, the move count and undo)",
        "file": "test/BoardRulesTest.cs",
        "rules": "a slide stops on the tile before a wall or the edge, snow stops the mote on the snow, every spark the mote passes is collected, the exit is plain ice until every spark is collected and then stops the mote and solves the level, a move that goes nowhere is not counted, and undo puts back the position, the sparks and the move count",
        "code": "scripts/Board.cs"
      },
      "unchanged": [
        "scripts/Board.cs"
      ],
      "mutantTests": [
        "test/BoardRulesTest.cs"
      ],
      "mutants": [
        {
          "name": "a slide stops one tile early",
          "file": "scripts/Board.cs",
          "find": "while (Tile(at + direction) != Wall)",
          "replace": "while (Tile(at + direction * 2) != Wall)"
        },
        {
          "name": "snow does not stop the mote",
          "file": "scripts/Board.cs",
          "find": "if (Tile(at) == Snow)",
          "replace": "if (Tile(at) == Wall)"
        },
        {
          "name": "the exit opens with one spark left",
          "file": "scripts/Board.cs",
          "find": "if (at == Exit && collected.Count == remaining.Count)",
          "replace": "if (at == Exit && collected.Count + 1 >= remaining.Count)"
        },
        {
          "name": "only a spark the mote stops on is collected",
          "file": "scripts/Board.cs",
          "find": "if (remaining.Contains(at) && !collected.Contains(at))",
          "replace": "if (remaining.Contains(at) && !collected.Contains(at) && Tile(at + direction) == Wall)"
        },
        {
          "name": "a move that goes nowhere is counted",
          "file": "scripts/Board.cs",
          "find": "if (result.To == Position)",
          "replace": "if (Solved)"
        },
        {
          "name": "undo keeps the move count",
          "file": "scripts/Board.cs",
          "find": "Moves = last.Moves;",
          "replace": "Moves = Moves;"
        }
      ],
      "reference": "solutions/prototype/write-tests"
    },
    {
      "template": "add-feature",
      "vars": {
        "feature": "a hint: Solver (scripts/Solver.cs) gets a method Vector2I Hint(Board board), the direction of the first move of a shortest solution from the board's current state, or Vector2I.Zero when the exit cannot be reached from there or the level is solved"
      },
      "hidden": [
        "hidden/HiddenHintTest.cs"
      ],
      "reference": "solutions/prototype/add-feature"
    },
    {
