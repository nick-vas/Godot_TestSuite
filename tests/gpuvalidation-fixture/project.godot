; Engine configuration file.
config_version=5

[application]

config/name="GPU validation fixture"
run/main_scene="res://clean.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=320
window/size/viewport_height=180

[rendering]

; Vulkan: validation layers exist only for Forward+ and Mobile. On a machine without a GPU, Mesa's lavapipe
; (mesa-vulkan-drivers) draws in software, and vulkan-validationlayers provides the Khronos layer.
renderer/rendering_method="forward_plus"
