; Engine configuration file.
config_version=5

[application]

config/name="Bench fixture"
run/main_scene="res://fly.tscn"
config/features=PackedStringArray("4.7")

[display]

; Small, so a software renderer (CI's virtual display) draws a frame in about a millisecond.
window/size/viewport_width=320
window/size/viewport_height=180

[rendering]

; OpenGL: CI's virtual display has no Vulkan.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
