{
  "name": "rotating between press and release keeps the action held, lays out again, and the release still arrives",
  "scene": "res://rotation.tscn",
  "steps": [
    { "assert": { "node": "Panel", "prop": "size:x", "equals": 1280 } },
    { "assert": { "node": "Panel", "prop": "size:y", "equals": 720 } },
    { "hold": "jump" },
    { "assert": { "node": ".", "prop": "presses", "equals": 1 } },
    { "resize": [720, 1280] },
    { "assert": { "node": ".", "prop": "resizes", "equals": 1 } },
    { "assert": { "node": ".", "prop": "held_at_resize", "equals": true } },
    { "assert": { "node": "Panel", "prop": "size:y", "gt": 2000 } },
    { "wait": 3 },
    { "assert": { "node": ".", "prop": "releases", "equals": 0 } },
    { "resize": [1280, 720] },
    { "release": "jump" },
    { "assert": { "node": ".", "prop": "releases", "equals": 1 } },
    { "assert": { "node": ".", "prop": "resizes", "equals": 2 } },
    { "assert": { "node": "Panel", "prop": "size:y", "equals": 720 } }
  ]
}
