{
  "tables": {
    "techs": { "file": "data/techs.json", "id": "id", "fields": { "requires": { "ref": "techs", "list": true, "optional": true, "acyclic": true } } },
    "items": { "file": "data/items.json", "id": "id", "fields": { "price": { "type": "int", "min": 0 } } },
    "enemies": { "file": "data/enemies.csv", "id": "id", "fields": { "hp": { "type": "int", "min": 1 }, "drops": { "ref": "items", "list": true, "optional": true } } },
    "mechanics": { "file": "data/mechanics.json", "id": "id", "fields": {} },
    "puzzles": { "file": "data/puzzles.json", "id": "id",
      "fields": { "kind": { "enum": ["puzzle", "action"] }, "purpose": { "enum": ["teach", "reinforce", "moment", "breather"] },
                  "mechanics": { "ref": "mechanics", "list": true },
                  "solution": { "type": "string", "pattern": "^(?!.*[.!?]\\s+\\S)\\s*\\S.*$" } } },
    "talk": { "file": "data/talk.json", "kind": "responses", "facts": ["gold"], "voiced": false },
    "greet": { "file": "data/greet.json", "kind": "responses", "locales": ["fr", "de"] },
    "levels": { "file": "data/softlock.json", "kind": "softlock" },
    "flows": { "file": "data/flows.json", "id": "id", "fields": { "currency": { "type": "string" }, "perHour": { "type": "number" } },
               "economy": { "currency": "currency", "rate": "perHour" } }
  }
}
